# WCC Rack View server settings. The installer copies this to config.env;
# edit that copy, then restart the service. Lines starting with # are ignored.

# Folder that holds rack-data.json, unifi.json, features-bugs.json and photos.
# Keep it outside the app folder so upgrades never touch it.
RACK_DATA_DIR=

# Port the web server listens on (443 = https, the release default; sign-in needs https).
PORT=443

# ---- HTTPS (no IIS/nginx needed) ----
# Put the certificate in the app folder and name it here, e.g. rackview.pfx (+ password)
# or rackview.crt + rackview.key. Use PORT=443 with it. http:// visitors are redirected.
TLS_CERT=
TLS_KEY=
TLS_PFX_PASSWORD=
HTTP_REDIRECT_PORT=80

# Only if IIS or nginx is used instead: set to 1 sits in front (see README-deploy.md), so roles use the
# browser's address instead of the proxy's.
TRUST_PROXY=0

# Seconds between automatic device up-checks (0 turns them off).
CHECK_INTERVAL=60

# ---- Microsoft Entra ID sign-in (SSO) ----
# The release always requires sign-in. Until all six settings below are filled in, the site shows only a
# page listing what is missing (nothing else is reachable). See IT-HANDOVER.md for the app registration.
REQUIRE_SSO=1
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Must match the redirect URI on the app registration exactly, e.g. https://rackview.example.org/auth/callback
ENTRA_REDIRECT_URI=
# Object IDs of the two Entra security groups. Owner: everything (incl. UniFi sync and signing off
# features/bugs). Admin: edit racks and log features/bugs. Anyone else who signs in is turned away.
ENTRA_OWNER_GROUP_ID=
ENTRA_ADMIN_GROUP_ID=

# ---- Updates ----
# Updates download from the public GitHub repository, so this can stay blank.
GITHUB_REPO=arobson-ui/Rack-View
GITHUB_TOKEN=
